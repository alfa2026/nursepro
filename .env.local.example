# ══════════════════════════════════════════════════════
#   PRO Nurse Enterprise ERP — Environment Variables
#   Copy this file to .env.local and fill in the values
# ══════════════════════════════════════════════════════

# ─── Firebase Configuration ────────────────────────────
# Get these values from: https://console.firebase.google.com
# → Project Settings → General → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ─── WhatsApp Business API (Optional) ──────────────────
# Get the token from: https://developers.facebook.com → WhatsApp → API Setup
# If left empty, WhatsApp links will open the wa.me deep link instead

NEXT_PUBLIC_WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID
NEXT_PUBLIC_WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxx

# ─── Build Configuration (Optional) ────────────────────
# Set to "true" when building for Docker/standalone deployment
# BUILD_STANDALONE=true

# ─── Google Login Setup ────────────────────────────────
# 1. Go to Firebase Console → Authentication → Sign-in method
# 2. Enable Google provider
# 3. Add your domain in Authorized domains
# 4. Copy Firebase settings above
